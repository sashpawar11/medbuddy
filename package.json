{
  "name": "medbuddy",
  "version": "1.0.2",
  "description": "Personal family medical vault with local AI analysis",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "package": "electron-builder",
    "dist": "electron-builder",
    "test": "ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron ./node_modules/tsx/dist/cli.mjs test/integration.test.ts && ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron ./node_modules/tsx/dist/cli.mjs test/sync.test.ts && ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron ./node_modules/tsx/dist/cli.mjs test/organize.test.ts && ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron ./node_modules/tsx/dist/cli.mjs --test test/timeline.test.ts && ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron ./node_modules/tsx/dist/cli.mjs test/chat.test.ts"
  },
  "desktopName": "medbuddy.desktop",
  "build": {
    "appId": "com.medbuddy.app",
    "productName": "MedBuddy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/main/**/*",
      "dist-electron/preload/**/*",
      "package.json",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,test,tests,example,examples}",
      "!**/node_modules/*/__tests__/**",
      "!**/node_modules/**/*.d.ts",
      "!**/node_modules/**/*.map"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/better-sqlite3/**/*",
      "node_modules/@napi-rs/**/*",
      "node_modules/onnxruntime-node/bin/**/*"
    ],
    "afterPack": "scripts/pruneRelease.cjs",
    "compression": "maximum",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.medical"
    },
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MedBuddy",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office;Medical",
      "maintainer": "MedBuddy Team <support@medbuddy.app>",
      "syncDesktopName": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sashpawar11",
        "repo": "medbuddy",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sashpawar11/medbuddy.git"
  },
  "keywords": [
    "electron",
    "medical",
    "vault",
    "ai",
    "ollama",
    "lm-studio"
  ],
  "author": "MedBuddy Team <support@medbuddy.app>",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "better-sqlite3": "^11.8.1",
    "onnxruntime-node": "^1.30.0",
    "pdfjs-dist": "^6.3.289",
    "ppu-paddle-ocr": "^6.6.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^0.475.0",
    "marked": "^18.0.14",
    "postcss": "^8.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "zod": "^3.24.2"
  }
}
