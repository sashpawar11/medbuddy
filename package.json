{
  "name": "medbuddy",
  "version": "1.0.0",
  "description": "Personal family medical vault with local AI analysis",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "package": "electron-builder",
    "dist": "electron-builder",
    "test": "ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron ./node_modules/tsx/dist/cli.mjs test/integration.test.ts && ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron ./node_modules/tsx/dist/cli.mjs test/sync.test.ts && ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron ./node_modules/tsx/dist/cli.mjs test/organize.test.ts && ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron ./node_modules/tsx/dist/cli.mjs --test test/timeline.test.ts"
  },
  "build": {
    "appId": "com.medbuddy.app",
    "productName": "MedBuddy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/better-sqlite3/**/*",
      "node_modules/canvas/**/*",
      "node_modules/onnxruntime-node/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.medical"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office;Medical"
    }
  },
  "keywords": [
    "electron",
    "medical",
    "vault",
    "ai",
    "ollama",
    "lm-studio"
  ],
  "author": "",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "canvas": "^3.2.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "onnxruntime-node": "^1.30.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^6.3.289",
    "ppu-paddle-ocr": "^6.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
